{
  "manifest_version": 3,
  "name": "QuickShot Pro",
  "short_name": "QuickShot",
  "description": "Professional screenshot tool with editing features",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickShot Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab","storage","downloads","scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+S" }, "description": "Open QuickShot" },
    "capture-visible": { "suggested_key": { "default": "Ctrl+Shift+V" }, "description": "Capture visible tab" },
    "capture-full": { "suggested_key": { "default": "Ctrl+Shift+F" }, "description": "Capture full page" },
    "toggle-ui": { "suggested_key": { "default": "Ctrl+Shift+U" }, "description": "Toggle UI" }
  },
  "minimum_chrome_version": "88"
}
